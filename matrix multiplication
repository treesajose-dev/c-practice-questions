#include <stdio.h>
#include <stdlib.h>

int main() {
    int r1, c1, r2, c2;

    // 1. Get dimensions of the first matrix
    printf("Enter rows and columns for the first matrix: ");
    if (scanf("%d %d", &r1, &c1) != 2) return 1;

    // 2. Get dimensions of the second matrix
    printf("Enter rows and columns for the second matrix: ");
    if (scanf("%d %d", &r2, &c2) != 2) return 1;

    // 3. Rule Check: Columns of 1st matrix must equal rows of 2nd matrix
    if (c1 != r2) {
        printf("Error: Multiplication not possible. Columns of 1st matrix must equal rows of 2nd matrix.\n");
        return 0;
    }

    // Declare matrices with user-defined sizes (Variable Length Arrays)
    int a[r1][c1];
    int b[r2][c2];
    int result[r1][c2];

    // 4. Input elements of the first matrix
    printf("\nEnter elements of matrix 1:\n");
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c1; j++) {
            printf("Enter element a[%d][%d]: ", i + 1, j + 1);
            if (scanf("%d", &a[i][j]) != 1) return 1;
        }
    }

    // 5. Input elements of the second matrix
    printf("\nEnter elements of matrix 2:\n");
    for (int i = 0; i < r2; i++) {
        for (int j = 0; j < c2; j++) {
            printf("Enter element b[%d][%d]: ", i + 1, j + 1);
            if (scanf("%d", &b[i][j]) != 1) return 1;
        }
    }

    // 6. Initialize result matrix elements to 0 and multiply
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            result[i][j] = 0; // Crucial step to avoid garbage values
            for (int k = 0; k < c1; k++) {
                result[i][j] += a[i][k] * b[k][j];
            }
        }
    }

    // 7. Display the result matrix
    printf("\nResultant Output Matrix:\n");
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            printf("%d\t", result[i][j]);
        }
        printf("\n");
    }

    return 0;
}
